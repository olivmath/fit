# Arbitrum Sepolia Deployment Configuration

# Private key of the deployer account (MUST HAVE testnet ETH)
# Export from your wallet (MetaMask, etc.)
ARBITRUM_SEPOLIA_PRIVATE_KEY=0x...

# Arbitrum Sepolia RPC URL
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=...

# Optional: Blockscout API for verification
BLOCKSCOUT_API_KEY=...
